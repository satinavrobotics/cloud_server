# Graph Builder Service Configuration

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=robot/node_update
MQTT_IMAGE_TOPIC=robot/image_upload
MQTT_DEPTH_TOPIC=robot/depth_upload
MQTT_COSTMAP_TOPIC=robot/costmap_upload

# Service URLs
IMAGE_DB_URL=http://localhost:6002
GRAPH_DB_URL=http://localhost:6001
SIMILARITY_SERVICE_URL=http://localhost:8003

# Graph Building Configuration
RADIUS_THRESHOLD=5.0
DEFAULT_MAP_ID=default
IMAGE_BUFFER_TIMEOUT=30.0
# Cap of each upload buffer (image, depth, costmap): bytes of base64 data and entries
UPLOAD_BUFFER_MAX_BYTES=268435456
UPLOAD_BUFFER_MAX_ENTRIES=5000

# Service Configuration
GRAPH_BUILDER_PORT=8004

