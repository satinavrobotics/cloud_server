# The cloud server (the dev box, tailnet 100.85.3.47). Renders to docker_compose/.env, which compose reads by default.
# Docker images
MISSION_DATABASE_IMAGE=mission_database:latest
MISSION_DISPATCH_IMAGE=mission_dispatch:latest
GRAPH_DB_SERVICE_IMAGE=graph_db_service:latest
IMAGE_DB_SERVICE_IMAGE=image_db_service:latest
GRAPH_BUILDER_SERVICE_IMAGE=graph_builder_service:latest
MISSION_PLANNER_SERVICE_IMAGE=mission_planner_service:latest
API_DELEGATION_SERVICE_IMAGE=api_delegation_service:latest

# MQTT
MQTT_BROKER=localhost
MQTT_KEEPALIVE=60
# Enable MQTT mission image publishing
MQTT_ENABLED=true

# Mission database
DATABASE_API_PORT=5000
# Internal communication between mission dispatch and mission database
DATABASE_CONTROLLER_PORT=5001
POSTGRES_DATABASE_HOST=localhost

# ArangoDB (topological map)
ARANGO_PORT=8529

# Graph Database Service
GRAPH_DB_PORT=6001
GRAPH_NAME=topological_map

# MinIO (image storage)
MINIO_HOST=100.85.3.47
MINIO_PORT=9000
MINIO_TAILNET_IP=100.85.3.47

# Image Database Service
IMAGE_DB_PORT=6002
IMAGE_DB_DEFAULT_MAP=default

# ROS Bag Storage
ROSBAG_PRESIGN_EXPIRY=3600

# Graph Builder Service
GRAPH_BUILDER_PORT=8004
GRAPH_BUILDER_MQTT_TOPIC=robot/node_update
GRAPH_BUILDER_RADIUS_THRESHOLD=2.0

# Mission Planner Service
MISSION_PLANNER_PORT=8005
MISSION_PLANNER_KNN_K=1
MISSION_PLANNER_RANGE_SEARCH_RADIUS=2.0

# API Delegation Service
API_DELEGATION_PORT=8000

# LiveKit (the keys are secrets)
LIVEKIT_SERVER_URL=wss://satinav-b22o2lgk.livekit.cloud
LIVEKIT_TTL=36000

# Dummy Robot Service (for testing)
DUMMY_ROBOT_IMAGE=dummy_robot:latest
DUMMY_ROBOT_NAME=dummy_robot_01
DUMMY_ROBOT_LOOP_RADIUS=10.0
DUMMY_ROBOT_SPEED=1.0
DUMMY_ROBOT_TICK_PERIOD=1.0

# 3D reconstruction (docs/reconstruction/design.md §13); the service is reconstruction_service.yaml
RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8009

# nodePolicy phase 1 (maxWaitS 10, skippable false); all robots migrated 2026-10-09
VDA5050_NODE_POLICY_MODE=on
NODE_POLICY_MAX_WAIT_S=10

# Scene graph (maps with status.scene_graph_enabled=false are skipped / use the legacy planner); on since 2026-10-13
SCENE_GRAPH_CACHE_VERSIONS=8
# planner mode: lazy (rollback: full_load)
SCENE_GRAPH_PLANNER_MODE=lazy
SCENE_GRAPH_NEAR_RANGE_M=1.3
SCENE_GRAPH_NEAR_MIN_CLEARANCE_M=0.25
SCENE_GRAPH_TURN_COST_ENABLED=true
SCENE_GRAPH_TURN_LAMBDA_M_PER_RAD=0.7
SCENE_GRAPH_WAYPOINT_BUDGET_M=0.35

# Semantic layer (docs/semantic/design.md)
SEMANTIC_SERVICE_URL=http://127.0.0.1:8010

# Scene-graph route inflation (docs/scene_graph/inflation_profile_design.md), set 2026-10-21
SCENE_GRAPH_INFLATION_RADIUS_M=0.8
SCENE_GRAPH_INFLATION_SCALING=6
SCENE_GRAPH_SAFETY_KAPPA=1

# Mesh service (docs/mesh/design.md)
MESH_SERVICE_URL=http://127.0.0.1:8012

# Operator actions from the desktop app (need OPERATIONS_TOKEN in secrets.env)
OPERATIONS_ENABLED=true
