# Shared defaults, every machine. A profile (server.env, pi4.env, pi5.env) overrides these and adds its own.
# Non-secret settings only: passwords, keys and secrets live in secrets.env (untracked; see secrets/*.env.example).
MQTT_PORT_TCP=1883
MQTT_PORT_WEBSOCKET=9001
MQTT_TRANSPORT=websockets
POSTGRES_DATABASE_NAME=mission
POSTGRES_DATABASE_USERNAME=postgres
POSTGRES_DATABASE_PORT=5432
GRAPH_DB_NAME=topomap_db
# NOT 9001: that is mosquitto's websocket port (everything uses host networking)
MINIO_CONSOLE_PORT=9002
SCENE_GRAPH_WORKER_ENABLED=true
SCENE_GRAPH_PLANNER_ENABLED=true
