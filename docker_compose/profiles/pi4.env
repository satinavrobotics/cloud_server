# Robot server on the Pi 4 (4 GB, hostname raspberrypi, tailnet 100.116.20.49). Renders to docker_compose/.env.robot.
# Only what differs from the compose defaults; memory limits stay at the defaults (sized for 4 GB).
# IMAGE_TAG is not here: scripts/deploy_robot.sh sets it per release and render_env keeps the one already in .env.robot.
ROBOT_TAILNET_IP=100.116.20.49
ROBOT_LAN_IP=0.0.0.0
MINIO_DATA_DIR=/srv/sati/minio_data
IMAGE_REGISTRY=100.85.3.47:5050/sati

# Who this is (GET /api/v1/server-info)
SERVER_KIND=robot
SERVER_NAME=raspberrypi
COMPOSE_PROFILES=diagnostics
SERVER_DIAGNOSTICS_AVAILABLE=true
SERVER_LIVEKIT_AVAILABLE=true

# Memory (read once at the first initdb for PG_TUNE_*)
PG_TUNE_MEMORY=512MB
MEM_GRAPH_BUILDER=1g

# Raw reconstruction on the robot (reconstruction_service_robot.yaml); the key and callback secret are secrets
RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8009

# Operator actions from the desktop app. Callers on the tailnet need no token; everyone else needs OPERATIONS_TOKEN (secrets.env)
OPERATIONS_ENABLED=true
OPERATIONS_TRUST_TAILNET=true
