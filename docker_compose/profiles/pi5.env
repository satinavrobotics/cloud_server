# Robot server on the Pi 5 (8 GB, 4 cores, hostname rasp, login satipi, tailnet 100.110.187.108). Renders to docker_compose/.env.robot.
# Checked against the machine itself on 2026-10-21 (docker 28.3.2, compose 2.38, Debian 12, kernel 6.12.34+rpt-rpi-v8).
# Page size: the stock Pi 5 kernel uses 16 KB pages, which the stack does not run on; /boot/firmware/config.txt has kernel=kernel8.img
# (the 4 KB kernel; `getconf PAGESIZE` must say 4096). Do not remove that line or update the firmware without checking it.
# IMAGE_TAG is not here: deploy_robot.sh sets it per release and render_env keeps the one already in .env.robot.
ROBOT_TAILNET_IP=100.110.187.108
MINIO_DATA_DIR=/srv/sati/minio_data
IMAGE_REGISTRY=100.85.3.47:5050/sati

# The robot LAN: eth0 is 192.168.1.70 (scripts/configure_pi_lan.sh --profile pi5). The gateway (80) and the MQTT broker (1883, 9001) also listen on
# this ONE address so the Jetson on that LAN can reach them. Keep it a single address, never 0.0.0.0: both allow anonymous clients.
ROBOT_LAN_IP=192.168.1.70
LAN_JETSON_IP=192.168.1.50
LAN_IFACE=eth0
# wlan is off on this Pi: the internet and Tailscale come through eth0 and this router (configure_pi_lan.sh --profile pi5)
LAN_WLAN_OFF=true
LAN_GATEWAY=192.168.1.1

# Who this is (GET /api/v1/server-info); the host name, set explicitly
SERVER_KIND=robot
SERVER_NAME=rasp
COMPOSE_PROFILES=diagnostics
SERVER_DIAGNOSTICS_AVAILABLE=true
SERVER_LIVEKIT_AVAILABLE=true

# Memory: what runs today is the 4 GB-class default set (PG_TUNE_* are read once, at the first initdb of the data volume). With 8 GB
# there is room to raise these, e.g. PG_TUNE_MEMORY=2GB MEM_POSTGRES=1500m MEM_ARANGO=1g MEM_GRAPH_BUILDER=1g: not done yet.
PG_TUNE_MEMORY=512MB

# Scene-graph route inflation, as set on this machine
SCENE_GRAPH_INFLATION_RADIUS_M=0.8
SCENE_GRAPH_INFLATION_SCALING=6
SCENE_GRAPH_SAFETY_KAPPA=1

# Raw reconstruction is off here (empty URL); the key and callback secret are optional secrets
RECONSTRUCTION_SERVICE_URL=

# Operator actions from the desktop app (this machine's image has them only after a deploy of a build from 2026-10-21 or later)
OPERATIONS_ENABLED=true
OPERATIONS_TRUST_TAILNET=true
