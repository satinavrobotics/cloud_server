# Robot server on the Pi 5 (8 GB, hostname satipi, tailnet 100.110.187.108). Renders to docker_compose/.env.robot.
# NOT yet checked against the machine's own .env.robot: the 8 GB limits are the ones .env.robot.example suggests.
# Run `scripts/render_env.sh pi5 --check` on the Pi and compare before the first real use.
ROBOT_TAILNET_IP=100.110.187.108
ROBOT_LAN_IP=0.0.0.0
MINIO_DATA_DIR=/srv/sati/minio_data
IMAGE_REGISTRY=100.85.3.47:5050/sati

# Who this is (GET /api/v1/server-info)
SERVER_KIND=robot
SERVER_NAME=satipi
COMPOSE_PROFILES=diagnostics
SERVER_DIAGNOSTICS_AVAILABLE=true
SERVER_LIVEKIT_AVAILABLE=true

# Memory: 8 GB (PG_TUNE_* are read once, at the first initdb of the data volume)
PG_TUNE_MEMORY=2GB
MEM_POSTGRES=1500m
MEM_ARANGO=1g
MEM_GRAPH_BUILDER=1g
ARANGO_BLOCK_CACHE_BYTES=268435456
ARANGO_WRITE_BUFFER_BYTES=268435456
ARANGO_QUERY_MEMORY_BYTES=536870912
UPLOAD_BUFFER_MAX_BYTES=256000000

RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8009
