# Settings for the livekit-sfu and livekit-sfu-tokens services in
# docker_compose/mission_dispatch_services.yaml. Copy to
# docker_compose/livekit_sfu.env (gitignored) and fill in.
#
# Deliberately a separate file from docker_compose/.env: that one holds the
# LiveKit *Cloud* pair under LIVEKIT_API_KEY/SECRET for livekit-service, and
# it is tracked in git.
#
# Generate a fresh pair with:  livekit-server generate-keys
# (or: docker run --rm livekit/livekit-server:v1.9.1 generate-keys)
# Never reuse the LiveKit Cloud pair here.
LIVEKIT_SFU_API_KEY=
LIVEKIT_SFU_API_SECRET=

# URL handed to robots in the token response: this box's Tailscale IP. Robots
# keep the plain ws:// IP so their video path doesn't depend on MagicDNS or
# `tailscale serve` cert renewal.
LIVEKIT_SFU_SERVER_URL=ws://100.85.3.47:7880

# URL handed to operators (the https dashboard, which can't open ws://). The
# `tailscale serve` name, tailnet-only; see docs/livekit_sfu/README.md §3:
#   sudo tailscale serve --bg --https=443 http://127.0.0.1:7880
# Optional: falls back to LIVEKIT_SFU_SERVER_URL when unset.
LIVEKIT_SFU_OPERATOR_URL=wss://admin-satinav-pc.tail055f44.ts.net

# Token lifetime in seconds for robots (10 hours).
LIVEKIT_SFU_TTL=36000

# Token lifetime for operators (the dashboard), default 3600. Shorter because
# these are minted on the public dashboard route and carry data-publish (teleop)
# rights. Connected participants are not dropped at expiry; the client just
# refetches when it next connects.
LIVEKIT_SFU_OPERATOR_TTL=3600
