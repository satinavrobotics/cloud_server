# Secrets for a robot server (pi4, pi5). Copy to docker_compose/secrets.env on the Pi (untracked, mode 600) and fill in.
# FRESH values: never reuse the cloud's. scripts/setup_robot.sh can generate them.
# CHANGE_ME = required; an empty value (KEY=) is optional.
POSTGRES_DATABASE_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
ARANGO_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
LIVEKIT_SFU_API_KEY=CHANGE_ME
LIVEKIT_SFU_API_SECRET=CHANGE_ME
RECONSTRUCTION_SERVICE_KEY=
RECONSTRUCTION_CALLBACK_SECRET=
# Token the app sends for operator actions (restart a service, deploy a tag). Empty = those actions stay off.
OPERATIONS_TOKEN=
