# Secrets for the cloud server. Copy to docker_compose/secrets.env (untracked, mode 600) and fill in.
# CHANGE_ME = required: render_env.sh stops if it is missing, empty or still CHANGE_ME. An empty value (KEY=) is optional.
POSTGRES_DATABASE_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
ARANGO_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
RECONSTRUCTION_SERVICE_KEY=CHANGE_ME
RECONSTRUCTION_CALLBACK_SECRET=CHANGE_ME
SEMANTIC_SERVICE_KEY=CHANGE_ME
SEMANTIC_CALLBACK_SECRET=CHANGE_ME
MESH_SERVICE_KEY=CHANGE_ME
MESH_CALLBACK_SECRET=CHANGE_ME
# Token the app sends for operator actions (restart a service). Empty = those actions stay off.
OPERATIONS_TOKEN=
