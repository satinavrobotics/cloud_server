# Robot (Raspberry Pi) gateway: the same public paths as the cloud gateway, in front of the robot's own services.
# The nginx image renders this with envsubst (/etc/nginx/templates/default.conf.template -> conf.d/default.conf),
# so only ${ROBOT_TAILNET_IP}, ${ROBOT_GATEWAY_PORT} and ${ROBOT_LAN_IP} are substituted; routing lives in routes.conf.
#
# Doors: loopback and the robot's tailnet IP, and nothing else unless ROBOT_LAN_IP is set (docs/robot_deploy.md). The
# gateway has no login, so a LAN door is an explicit choice: ROBOT_LAN_IP=<the robot's LAN address> or 0.0.0.0 (every
# interface). Unset, it is 127.0.0.2: a second loopback address nothing can reach from outside, which keeps this line valid.
# No UI is served from the robot: the desktop app brings its own, so there are no Expo (web_server) blocks.

# No CORS on a robot (cors-robot.conf): see the comment there.
include /etc/nginx/sati/cors-robot.conf;

gzip on;
gzip_types application/json application/octet-stream;
gzip_min_length 1024;
gzip_vary on;

upstream backend_api {
    server 127.0.0.1:8000;
}

# Not part of the robot stack (profile cloud-only): the prefix answers 502 and
# GET /api/v1/server-info reports the agent as unavailable.
upstream agent_api {
    server 127.0.0.1:8007;
}

# The robot's own token service listens on the tailnet IP (robots call it there), not on loopback.
# Server diagnostics (container status and logs), loopback only.
upstream diagnostics_api {
    server 127.0.0.1:8011;
}

upstream livekit_selfhost_api {
    server ${ROBOT_TAILNET_IP}:8008;
}

server {
    listen 127.0.0.1:${ROBOT_GATEWAY_PORT};
    listen ${ROBOT_TAILNET_IP}:${ROBOT_GATEWAY_PORT};
    listen ${ROBOT_LAN_IP}:${ROBOT_GATEWAY_PORT};
    server_name _;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log /var/log/nginx/sati_access.log;
    error_log /var/log/nginx/sati_error.log;
    error_log /dev/stderr warn;     # also in `docker logs`, so server diagnostics can read it

    include /etc/nginx/sati/routes.conf;
}
