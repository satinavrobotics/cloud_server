# Docker images
MISSION_DATABASE_IMAGE=mission_database:latest
MISSION_DISPATCH_IMAGE=mission_dispatch:latest
GRAPH_DB_SERVICE_IMAGE=graph_db_service:latest
IMAGE_DB_SERVICE_IMAGE=image_db_service:latest
GRAPH_BUILDER_SERVICE_IMAGE=graph_builder_service:latest
MISSION_PLANNER_SERVICE_IMAGE=mission_planner_service:latest
API_DELEGATION_SERVICE_IMAGE=api_delegation_service:latest

# MQTT
# The TCP port for the MQTT broker to listen on
MQTT_PORT_TCP=1883
# The WEBSOCKET port for the MQTT broker to listen on
MQTT_PORT_WEBSOCKET=9001
# The transport mechanism("websockets", "tcp") for MQTT
MQTT_TRANSPORT=websockets
# MQTT broker address
MQTT_BROKER=localhost
# MQTT keepalive interval in seconds
MQTT_KEEPALIVE=60
# Enable MQTT mission image publishing
MQTT_ENABLED=true

# Mission database
# Port for mission database to host the REST API on
DATABASE_API_PORT=5000
# Port used for internal communication between mission dispatch and mission database
DATABASE_CONTROLLER_PORT=5001
# The name of database to connect to in postgres
POSTGRES_DATABASE_NAME=mission
# The postgres username to use
POSTGRES_DATABASE_USERNAME=postgres
# The postgres password to use
POSTGRES_DATABASE_PASSWORD=postgres
POSTGRES_PASSWORD=postgres
# The hostname of the postgres server
POSTGRES_DATABASE_HOST=localhost
# Starting PostgreSQL Db on this port
POSTGRES_DATABASE_PORT=5432

# ArangoDB (for topological map)
ARANGO_PORT=8529
ARANGO_ROOT_PASSWORD=openSesame

# Graph Database Service
GRAPH_DB_PORT=6001
GRAPH_DB_NAME=topomap_db
GRAPH_NAME=topological_map

# MinIO (for image storage)
MINIO_HOST=100.85.3.47
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Image Database Service
IMAGE_DB_PORT=6002
IMAGE_DB_DEFAULT_MAP=default

# ROS Bag Storage
ROSBAG_PRESIGN_EXPIRY=3600

# Graph Builder Service
GRAPH_BUILDER_PORT=8004
GRAPH_BUILDER_MQTT_TOPIC=robot/node_update
GRAPH_BUILDER_RADIUS_THRESHOLD=2.0

# Mission Planner Service
MISSION_PLANNER_PORT=8005
MISSION_PLANNER_KNN_K=1
MISSION_PLANNER_RANGE_SEARCH_RADIUS=2.0

# API Delegation Service
API_DELEGATION_PORT=8000

# LiveKit
LIVEKIT_API_KEY=APItMSWMP3TVdfZ
LIVEKIT_API_SECRET=5aTOwvNSIY8Jvi5lEeBrffpb7P8n6MchhdysejZ8gcwD
LIVEKIT_SERVER_URL=wss://satinav-b22o2lgk.livekit.cloud
LIVEKIT_TTL=36000

# Dummy Robot Service (for testing)
DUMMY_ROBOT_IMAGE=dummy_robot:latest
DUMMY_ROBOT_NAME=dummy_robot_01
DUMMY_ROBOT_LOOP_RADIUS=10.0
DUMMY_ROBOT_SPEED=1.0
DUMMY_ROBOT_TICK_PERIOD=1.0
