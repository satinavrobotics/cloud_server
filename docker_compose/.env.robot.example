# Robot (Raspberry Pi) environment for mission_dispatch_services_robot.yaml. Copy to .env.robot (gitignored) on the Pi
# and fill in FRESH secrets: never reuse the cloud's. Everything not listed here takes the compose default.
# Always pass it explicitly: docker compose --env-file .env.robot ... (docker_compose/.env is the cloud's file).

# --- the Pi
ROBOT_TAILNET_IP=100.x.y.z            # `tailscale ip -4`: mosquitto, minio-tailnet and the presigned URLs use it
MINIO_DATA_DIR=/srv/sati/minio_data   # on the SSD

# --- who this is (GET /api/v1/server-info: the app reads it to know what this server has; packages/api/server_info.py)
SERVER_KIND=robot                     # "robot" here, "cloud" (the default) on the cloud server
SERVER_NAME=                          # shown in the app; empty = this host's name
SERVER_ID=                            # a stable id for this robot server (used when data is copied between servers)
# SERVER_AGENT_AVAILABLE is off for a robot unless set; MIN_CLIENT_VERSION / RECOMMENDED_CLIENT_VERSION (x.y.z) are optional.
SERVER_LIVEKIT_AVAILABLE=true         # this robot runs its own video server and token service (decision D1)

# --- video: the robot's own LiveKit SFU. Fresh pair; never reuse the cloud's. (`livekit-server generate-keys` makes one too.)
# Optional: LIVEKIT_SFU_SERVER_URL (default ws://ROBOT_TAILNET_IP:7880, what robots and clients are told), MEM_LIVEKIT (192m).
LIVEKIT_SFU_API_KEY=CHANGE_ME
LIVEKIT_SFU_API_SECRET=CHANGE_ME      # 32+ characters

# --- the robot's nginx front door (the nginx-gateway service in mission_dispatch_services_robot.yaml): loopback + ROBOT_TAILNET_IP only; the port is yours to move
ROBOT_GATEWAY_PORT=80

# --- images (scripts/build_push.sh prints "On the robot: IMAGE_TAG=...")
IMAGE_REGISTRY=100.85.3.47:5050/sati
IMAGE_TAG=latest                      # pin a git sha for a reproducible deploy (and a meaningful rollback)

# --- memory (defaults: a 4 GB Pi, ~3.4 GB of limits). For 8 GB, e.g.:
#   PG_TUNE_MEMORY=2GB  MEM_POSTGRES=1500m  MEM_ARANGO=1g  ARANGO_BLOCK_CACHE_BYTES=268435456
#   ARANGO_WRITE_BUFFER_BYTES=268435456  ARANGO_QUERY_MEMORY_BYTES=536870912  UPLOAD_BUFFER_MAX_BYTES=256000000
# PG_TUNE_* are read once, at the first initdb of the data volume. Other knobs: MEM_MOSQUITTO, MEM_MINIO, MEM_DISPATCH,
# MEM_GRAPH_BUILDER, MEM_PLANNER, MEM_API.
PG_TUNE_MEMORY=512MB
MEM_POSTGRES=768m
MEM_ARANGO=768m

# --- same names as the cloud's docker_compose/.env
MQTT_PORT_TCP=1883
MQTT_PORT_WEBSOCKET=9001
MQTT_TRANSPORT=websockets
POSTGRES_DATABASE_NAME=mission
POSTGRES_DATABASE_USERNAME=postgres
POSTGRES_DATABASE_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME           # same value as POSTGRES_DATABASE_PASSWORD
POSTGRES_DATABASE_PORT=5432
ARANGO_ROOT_PASSWORD=CHANGE_ME
GRAPH_DB_NAME=topomap_db
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_CONSOLE_PORT=9002               # NOT 9001: that is mosquitto's websocket port (all host networking)

# --- scene graph: runs on the robot (decision D4, 2026-10-18). Memory on a 4 GB Pi is NOT measured yet: watch MEM_* first.
SCENE_GRAPH_WORKER_ENABLED=true
SCENE_GRAPH_PLANNER_ENABLED=true      # route planning on the scene graph; caps for both in the robot compose file

# --- raw reconstruction, no PyTorch (decision D4; reconstruction_service_robot.yaml). Empty = off. When on, set
# RECONSTRUCTION_SERVICE_URL=http://localhost:8009 and start that service: the app is told "reconstruction: available"
# from this setting alone, it does not check that the service is up.
RECONSTRUCTION_SERVICE_URL=
RECONSTRUCTION_SERVICE_KEY=
RECONSTRUCTION_CALLBACK_SECRET=
