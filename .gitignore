bazel-*
__pycache__
.vscode
.env
.serena
.claude
htmlcov/*

# Self-hosted LiveKit key pair (livekit-sfu services in docker_compose/mission_dispatch_services.yaml)
docker_compose/livekit_sfu.env

# Staging rehearsal credentials (docker_compose/mission_dispatch_services_staging_override.yaml)
docker_compose/.env.staging
docker_compose/.env.robot
docker_compose/.robot_current_tag
docker_compose/.robot_previous_tag

# Backups of the robot env file (hold real credentials)
docker_compose/.env.robot.bak-*

# Per-machine secrets and the env files rendered from them (scripts/render_env.sh); the profiles themselves are tracked
docker_compose/secrets.env
docker_compose/.env.robot.bak*
docker_compose/*.bak
docker_compose/secrets.*.env

# Local settings overrides written by the app on each machine
docker_compose/local/overrides.env

# test coverage output
.coverage
coverage.xml
