# Dummy Robot Configuration

# Robot Identity
DUMMY_ROBOT_NAME=dummy_robot_01
DUMMY_ROBOT_MANUFACTURER=DummyManufacturer
DUMMY_ROBOT_SERIAL=DUMMY001

# Movement Configuration
DUMMY_ROBOT_LOOP_RADIUS=10.0
DUMMY_ROBOT_SPEED=1.0
DUMMY_ROBOT_TICK_PERIOD=1.0

# MQTT Configuration (should match mission dispatch services)
MQTT_HOST=localhost
MQTT_PORT_TCP=1883
MQTT_PREFIX=uagv/v2/RobotCompany

# Map Configuration
IMAGE_DB_DEFAULT_MAP=default

# Graph Builder Configuration
GRAPH_BUILDER_MQTT_TOPIC=robot/node_update

