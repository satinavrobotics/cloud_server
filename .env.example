# =============================================================
#  Cloud Server — Environment Variables Template
#  Copy this file to .env and fill in the values.
#  .env is gitignored and should NEVER be committed.
# =============================================================

# ---- Database credentials ----
ARANGO_PASSWORD=<your-arangodb-password>

MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_PUBLIC_HOST=<tailscale-or-public-ip-of-cloud-server>

POSTGRES_PASSWORD=<your-postgres-password>

# ---- Service URLs ----
# Services below communicate internally at fixed ports (see config.py).
# Only override these if you're running services on non-default hosts.
MISSION_PLANNER_URL=http://localhost:8005
LIVEKIT_URL=http://localhost:8006

# ---- MQTT ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
# Must match the mission controller's VDA5050 topic prefix.
MQTT_VDA5050_PREFIX=uagv/v2/RobotCompany

# ---- Agent Orchestrator (LLM fleet triage) ----
# Optional: when unset the orchestrator runs in degraded (non-LLM) mode.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
AGENT_MODEL=claude-haiku-4-5
AGENT_BATTERY_LOW_THRESHOLD=20.0

# ---- Free dev LLM via LiteLLM -> Gemini (optional; see docker_compose/llm_proxy.yaml) ----
# Run a real (non-degraded) model without Anthropic credits. To enable:
#   1. GEMINI_API_KEY: free key from https://aistudio.google.com/apikey
#   2. ANTHROPIC_BASE_URL=http://localhost:4000  (points the agent at the proxy)
#   3. ANTHROPIC_API_KEY=<same value as LITELLM_MASTER_KEY below>
#   4. AGENT_MODEL=gemini-3.5-flash    (gemini-2.0-flash was retired 2026-06-01)
# Leave ANTHROPIC_BASE_URL blank to use the real Anthropic API (or degraded mode).
GEMINI_API_KEY=
ANTHROPIC_BASE_URL=
LITELLM_MASTER_KEY=sk-litellm-local

# ---- LiveKit (required when running the livekit service) ----
LIVEKIT_API_KEY=APItMSWMP3TVdfZ
LIVEKIT_API_SECRET=5aTOwvNSIY8Jvi5lEeBrffpb7P8n6MchhdysejZ8gcwD
LIVEKIT_SERVER_URL=wss://satinav-b22o2lgk.livekit.cloud
LIVEKIT_TTL=36000

# ---- Order policy (mission-dispatch; read once at import, see order_policy.py) ----
# Invalid values log a warning and fall back to the default shown.
# allowedDeviationXY (m) on a pass-through node / the last node / the start node.
ROUTE_DEVIATION_XY_PASS_M=0.35
# The robot counts the final position reached at 0.35-0.45 m and cannot honour a tighter
# tolerance yet; precision for nodes with actions should come from the action (e.g. dock).
ROUTE_DEVIATION_XY_FINAL_M=0.35
ROUTE_START_DEVIATION_XY_M=0.35
# allowedDeviationTheta (rad): heading is free on pass-through nodes.
ROUTE_DEVIATION_THETA_PASS_RAD=3.1416
ROUTE_DEVIATION_THETA_FINAL_RAD=0.785
# A waypoint deviation of 0 means "not set" (true) rather than an exact-pose request.
ROUTE_DEVIATION_ZERO_IS_UNSET=true
# A waypoint allowedDeviationXY equal to this is the old Pose2D default: read as not set. none = off.
ROUTE_DEVIATION_XY_LEGACY_DEFAULT_M=0.1
# nodePolicy action: off | factsheet (only robots listing it) | on.
# All robots run the nodePolicy release (confirmed 2026-10-09), so on. A robot without it would
# report the action FAILED 'Action handler not found'; use factsheet if that can happen again.
# Phase 1: maxWaitS 10, skippable false.
VDA5050_NODE_POLICY_MODE=on
# Seconds a robot holds at a blocked pass-through node; capped at 120 (the robot's limit).
NODE_POLICY_MAX_WAIT_S=10
# Mission timeouts do not run while the robot is offline.
MISSION_TIMEOUT_PAUSE_OFFLINE=true
# Minutes a graph node the robot reported blocked is kept out of new routes.
BLOCKED_NODE_EXCLUSION_MIN=10
# Seconds a reroute waits for the robot to adopt the last order before cancelling it.
ORDER_CANCEL_MIN_DWELL_S=2
