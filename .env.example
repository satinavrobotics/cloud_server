# =============================================================
#  Cloud Server — Environment Variables Template
#  Copy this file to .env and fill in the values.
#  .env is gitignored and should NEVER be committed.
# =============================================================

# ---- Database credentials ----
ARANGO_PASSWORD=<your-arangodb-password>

MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_PUBLIC_HOST=<tailscale-or-public-ip-of-cloud-server>

POSTGRES_PASSWORD=<your-postgres-password>
# Compose has no defaults for these; the postgres container is initialised from them and
# graph-builder / mission-planner / API connect with them.
POSTGRES_DATABASE_NAME=mission
POSTGRES_DATABASE_USERNAME=postgres
POSTGRES_DATABASE_PASSWORD=<your-postgres-password>
POSTGRES_DATABASE_PORT=5432

# ---- Scene graph (docs/scene_graph/runbook.md; tuning vars default per packages/config.py) ----
# Ingest worker on graph-builder + reads/delete hooks on the API. Off by default.
SCENE_GRAPH_WORKER_ENABLED=false
# SCENE_GRAPH_BATCH_MIN_LEAVES=6  SCENE_GRAPH_BATCH_MAX_LEAVES=48  SCENE_GRAPH_PUBLISH_INTERVAL_S=5.0
# SCENE_GRAPH_BATCH_BUDGET_S=10.0  SCENE_GRAPH_IDLE_S=2.0  SCENE_GRAPH_IDLE_MAX_S=30.0
# SCENE_GRAPH_LIFECYCLE_CHECK_S=5.0
# Worker robustness (defaults per packages/config.py; docs/scene_graph/runbook.md section 1):
# SCENE_GRAPH_MAX_MAPS=64  SCENE_GRAPH_SAVE_EVERY_LEAVES=50  SCENE_GRAPH_SAVE_EVERY_S=30.0
# SCENE_GRAPH_REPLAY_MARGIN_S=60.0  SCENE_GRAPH_REPLAY_RECHECK_S=60.0  SCENE_GRAPH_REBUILD_MAX_AGE_S=900.0
# SCENE_GRAPH_REBUILD_BATCH=48  SCENE_GRAPH_REBUILD_DEBOUNCE_S=30.0  SCENE_GRAPH_LOAD_FAIL_LIMIT=3
# SCENE_GRAPH_STEP_BUDGET_S=0.0  SCENE_GRAPH_SLOW_STEP_S=30.0  SCENE_GRAPH_STATS_LOG_S=60.0
# SCENE_GRAPH_MEMORY_RETRY_LIMIT=3
# Receipt / replay (graph-builder): costmap_stored_ms counts as a leaf's receipt time only within
# RECEIPT_WINDOW_S of the node's own time (a later bulk write, e.g. a backfilled occupancy_depth, is not a
# receipt); <= 0 always trusts it. SKIP_FOLDED=true: a restart skips leaves the stored state already holds
# (key, stamp, pose, footprint, view) instead of folding the replay margin again; false folds them again.
# SCENE_GRAPH_RECEIPT_WINDOW_S=300.0  SCENE_GRAPH_SKIP_FOLDED=true
# Worker scale (graph-builder; runbook sections 1 and 8). Compose defaults WORKER_THREADS to 4 (the code's
# default when unset is min(8, CPU count); never set it empty). Set MAX_RESIDENT_BYTES to ~60-70% of the
# container memory limit (0 = no byte cap).
# SCENE_GRAPH_WORKER_THREADS=4  SCENE_GRAPH_LAZY_LOAD=true  SCENE_GRAPH_MAX_RESIDENT_ENGINES=32
# SCENE_GRAPH_MAX_RESIDENT_BYTES=0  SCENE_GRAPH_EVICT_IDLE_S=60.0
# SCENE_GRAPH_PREFETCH_THREADS=4  SCENE_GRAPH_PREFETCH_QUEUE=64
# Map delete waits for a running fold (API): SCENE_GRAPH_DELETE_LOCK_TIMEOUT_S=30.0  SCENE_GRAPH_DELETE_LOCK_DEADLINE_S=3600.0
# Chart-graph planner (mission-planner). Enable ONLY after step 6 of the runbook (worker has built
# the map, version published, reads verified). Off by default; the legacy planner is untouched.
SCENE_GRAPH_PLANNER_ENABLED=false
# SCENE_GRAPH_START_SNAP_M=0.5  SCENE_GRAPH_GOAL_SNAP_M=1.5  SCENE_GRAPH_LEAF_SNAP_M=1.0
# SCENE_GRAPH_MAX_WAYPOINT_GAP_M=5.0  SCENE_GRAPH_LOAD_TIMEOUT_S=2.0  SCENE_GRAPH_PLAN_BUDGET_S=3.0
# Clearance pricing of the chart route (docs/scene_graph/route_safety.md): the cost multiplier added at the inscribed floor
# (range 0 - 10, the measured plateau, not a bound of the theory; 0 = the shortest route). The margin is the planning robot's
# circumscribed radius, no other constant.
# SCENE_GRAPH_SAFETY_KAPPA=1.0
# SCENE_GRAPH_TOTAL_BUDGET_S=3.5  SCENE_GRAPH_PLAN_MAX_INFLIGHT=4   (total budget stays under the dispatcher's 5 s)
# SCENE_GRAPH_CACHE_VERSIONS=4  SCENE_GRAPH_CACHE_VERSIONS_PER_MAP=2  SCENE_GRAPH_CACHE_MAX_BYTES=0
# SCENE_GRAPH_LAZY_MAX_TILES=400  SCENE_GRAPH_LAZY_TILE_CACHE=512
# SCENE_GRAPH_META_TTL_S=0.75  SCENE_GRAPH_MAX_VERSION_LAG_S=120.0
# SCENE_GRAPH_WIDTH_CHECK_ENABLED=false  SCENE_GRAPH_WIDTH_MARGIN_M=0.05   (validate the 30 deg turn rule first: runbook "Width gate")
# SCENE_GRAPH_PREWARM_MAPS=<map-id>,<map-id>  SCENE_GRAPH_PREWARM_CONCURRENCY=2

# ---- Service URLs ----
# Services below communicate internally at fixed ports (see config.py).
# Only override these if you're running services on non-default hosts.
MISSION_PLANNER_URL=http://localhost:8005
LIVEKIT_URL=http://localhost:8006

# ---- MQTT ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
# Must match the mission controller's VDA5050 topic prefix.
MQTT_VDA5050_PREFIX=uagv/v2/RobotCompany

# ---- Agent Orchestrator (LLM fleet triage) ----
# Optional: when unset the orchestrator runs in degraded (non-LLM) mode.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
AGENT_MODEL=claude-haiku-4-5
AGENT_BATTERY_LOW_THRESHOLD=20.0

# ---- Free dev LLM via LiteLLM -> Gemini (optional; see docker_compose/llm_proxy.yaml) ----
# Run a real (non-degraded) model without Anthropic credits. To enable:
#   1. GEMINI_API_KEY: free key from https://aistudio.google.com/apikey
#   2. ANTHROPIC_BASE_URL=http://localhost:4000  (points the agent at the proxy)
#   3. ANTHROPIC_API_KEY=<same value as LITELLM_MASTER_KEY below>
#   4. AGENT_MODEL=gemini-3.5-flash    (gemini-2.0-flash was retired 2026-06-01)
# Leave ANTHROPIC_BASE_URL blank to use the real Anthropic API (or degraded mode).
GEMINI_API_KEY=
ANTHROPIC_BASE_URL=
LITELLM_MASTER_KEY=sk-litellm-local

# ---- LiveKit (required when running the livekit service) ----
LIVEKIT_API_KEY=APItMSWMP3TVdfZ
LIVEKIT_API_SECRET=5aTOwvNSIY8Jvi5lEeBrffpb7P8n6MchhdysejZ8gcwD
LIVEKIT_SERVER_URL=wss://satinav-b22o2lgk.livekit.cloud
LIVEKIT_TTL=36000

# ---- Order policy (mission-dispatch; read once at import, see order_policy.py) ----
# Invalid values log a warning and fall back to the default shown.
# allowedDeviationXY (m) on a pass-through node / the last node / the start node.
ROUTE_DEVIATION_XY_PASS_M=0.35
# The robot counts the final position reached at 0.35-0.45 m and cannot honour a tighter
# tolerance yet; precision for nodes with actions should come from the action (e.g. dock).
ROUTE_DEVIATION_XY_FINAL_M=0.35
ROUTE_START_DEVIATION_XY_M=0.35
# allowedDeviationTheta (rad): heading is free on pass-through nodes.
ROUTE_DEVIATION_THETA_PASS_RAD=3.1416
ROUTE_DEVIATION_THETA_FINAL_RAD=0.785
# A waypoint deviation of 0 means "not set" (true) rather than an exact-pose request.
ROUTE_DEVIATION_ZERO_IS_UNSET=true
# A waypoint allowedDeviationXY equal to this is the old Pose2D default: read as not set. none = off.
ROUTE_DEVIATION_XY_LEGACY_DEFAULT_M=0.1
# nodePolicy action: off | factsheet (only robots listing it) | on.
# All robots run the nodePolicy release (confirmed 2026-10-09), so on. A robot without it would
# report the action FAILED 'Action handler not found'; use factsheet if that can happen again.
# Phase 1: maxWaitS 10, skippable false.
VDA5050_NODE_POLICY_MODE=on
# Seconds a robot holds at a blocked pass-through node; capped at 120 (the robot's limit).
NODE_POLICY_MAX_WAIT_S=10
# Skippable nodes (docs/node_policies_2026-10-13.md): the planner marks go-here waypoints skippable
# with a corridor width from the scene graph and mission-dispatch sends skippable=true with it
# (false: every nodePolicy goes out not skippable). GAP_FILL: the planner inserts planned
# waypoints between an operator's waypoints that are not in the same or a neighbouring chart.
NODE_POLICY_SKIP_ENABLED=true
NODE_POLICY_GAP_FILL_ENABLED=true
# Mission timeouts do not run while the robot is offline.
MISSION_TIMEOUT_PAUSE_OFFLINE=true
# Minutes a graph node the robot reported blocked is kept out of new routes.
BLOCKED_NODE_EXCLUSION_MIN=10
# Seconds a reroute waits for the robot to adopt the last order before cancelling it.
ORDER_CANCEL_MIN_DWELL_S=2
